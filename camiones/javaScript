    ["Asientos", `${cm(W*.25)} × ${cm(cabH*.24)} × ${cm(cabLen*.19)}`, 2, "Madera / espuma", "Cabina"],
    ["Piso de caja", `${cm(W*.95)} × ${cm(t)} × ${cm(boxLen)}`, 1, "Contrachapado", "Carrocería"],
    ["Laterales de caja", `${cm(t)} × ${cm(boxH*.75)} × ${cm(boxLen)}`, 2, "Madera", "Carrocería"],
    ["Frente y puerta trasera", `${cm(W*.95)} × ${cm(boxH*.75)} × ${cm(t)}`, 2, "Madera", "Carrocería"],
    ["Ruedas", `Ø ${cm(wheelR*2)} × ${cm(W*.12)}`, 6, "Goma / impresión 3D", "Ruedas"],
    ["Rines", `Ø ${cm(wheelR*1.04)} × ${cm(W*.125)}`, 6, "Plástico / impresión 3D", "Ruedas"],
