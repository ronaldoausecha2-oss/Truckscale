import * as THREE from "three";
import { OrbitControls } from "three/addons/controls/OrbitControls.js";

const $ = id => document.getElementById(id);
const view = $("threeView");

let scene, camera, renderer, controls, truckRoot;
let partGroups = new Map();
let exploded = false;
let selectedPart = null;

const partDefinitions = [];

const presets = {
  cargo: [850, 250, 330],
  tractor: [1600, 250, 390],
  dump: [750, 250, 320],
  tanker: [950, 250, 340],
  fire: [900, 250, 340],
  crane: [900, 250, 350]
};

const fmt = n => Number(n).toLocaleString("es-CO", {
  minimumFractionDigits: 2,
  maximumFractionDigits: 2
});

const mat = (color, roughness = .72, metalness = .05) =>
  new THREE.MeshStandardMaterial({
    color,
    roughness,
    metalness
  });

const materials = {
  blue: mat("#1769aa"),
  blueDark: mat("#10416e"),
  glass: mat("#8bc8e8", .25, .1),
  black: mat("#171d26"),
  rubber: mat("#17191d"),
  metal: mat("#8996a5", .35, .65),
  silver: mat("#c4d0dc", .3, .7),
  white: mat("#e7edf3"),
  red: mat("#c83b36"),
  yellow: mat("#f5c542"),
  seat: mat("#303d50"),
  wood: mat("#a97845")
};

// INICIAR ESCENA 3D

function init3D() {
  scene = new THREE.Scene();
  scene.background = new THREE.Color("#0b1a2d");

  camera = new THREE.PerspectiveCamera(
    42,
    view.clientWidth / view.clientHeight,
    .1,
    1000
  );

  camera.position.set(10, 8, 12);

  renderer = new THREE.WebGLRenderer({
    antialias: true,
    alpha: false
  });

  renderer.setPixelRatio(
    Math.min(window.devicePixelRatio, 2)
  );

  renderer.setSize(
    view.clientWidth,
    view.clientHeight
  );

  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.outputColorSpace = THREE.SRGBColorSpace;

  view.prepend(renderer.domElement);

  controls = new OrbitControls(
    camera,
    renderer.domElement
  );

  controls.enableDamping = true;
  controls.target.set(0, 1.5, 0);
  controls.maxPolarAngle = Math.PI * .49;

  scene.add(
    new THREE.HemisphereLight(
      0xb9d8f5,
      0x27364b,
      2.1
    )
  );

  const key = new THREE.DirectionalLight(
    0xffffff,
    2.4
  );

  key.position.set(7, 12, 8);
  key.castShadow = true;
  scene.add(key);

  const fill = new THREE.DirectionalLight(
    0x5caeff,
    1.1
  );

  fill.position.set(-8, 5, -6);
  scene.add(fill);

  const floor = new THREE.Mesh(
    new THREE.PlaneGeometry(200, 200),
    mat("#14283f")
  );

  floor.rotation.x = -Math.PI / 2;
  floor.position.y = -.04;
  floor.receiveShadow = true;
  scene.add(floor);

  const grid = new THREE.GridHelper(
    30,
    30,
    "#34516f",
    "#1e3854"
  );

  grid.position.y = -.025;
  scene.add(grid);

  buildTruck();

  $("loading").style.display = "none";

  window.addEventListener("resize", onResize);

  animate();
}

// AJUSTAR PANTALLA

function onResize() {
  if (!renderer) return;

  camera.aspect =
    view.clientWidth / view.clientHeight;

  camera.updateProjectionMatrix();

  renderer.setSize(
    view.clientWidth,
    view.clientHeight
  );
}

// ANIMACIÓN

function animate() {
  requestAnimationFrame(animate);

  for (const [key, group] of partGroups) {
    const target = exploded
      ? group.userData.exploded
      : group.userData.home;

    group.position.lerp(target, .09);
  }

  controls.update();
  renderer.render(scene, camera);
}

// CREAR PIEZAS RECTANGULARES

function addBox(parent, name, dim, pos, material, groupKey = name) {
  const g = partGroups.get(groupKey);

  const mesh = new THREE.Mesh(
    new THREE.BoxGeometry(...dim),
    material
  );

  mesh.position.set(...pos);
  mesh.castShadow = true;
  mesh.receiveShadow = true;
  mesh.userData.partKey = groupKey;

  g.add(mesh);

  return mesh;
}

// CREAR GRUPOS DE PIEZAS

function makeGroup(
  key,
  description,
  measurement,
  quantity,
  material,
  home,
  explode
) {
  const group = new THREE.Group();

  group.name = key;

  group.userData = {
    home: new THREE.Vector3(...home),
    exploded: new THREE.Vector3(...explode),
    description,
    measurement,
    quantity,
    material
  };

  group.position.copy(group.userData.home);

  truckRoot.add(group);
  partGroups.set(key, group);

  partDefinitions.push({
    key,
    name: key,
    description,
    measurement,
    quantity,
    material
  });

  return group;
}

// CONSTRUIR CAMIÓN 3D

function buildTruck() {
  if (truckRoot) {
    scene.remove(truckRoot);

